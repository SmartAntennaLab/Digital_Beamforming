global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/dbf-alerts.yml

scrape_configs:
  - job_name: digital-beamforming
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:8501
          # Add every Streamlit replica so process-local metrics are not hidden.
          # - 127.0.0.1:8502
