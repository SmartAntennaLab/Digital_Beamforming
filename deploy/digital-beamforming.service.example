[Unit]
Description=Digital beamforming Streamlit application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=digital-beamforming
Group=digital-beamforming
WorkingDirectory=/opt/digital-beamforming
EnvironmentFile=-/etc/digital-beamforming.env
ExecStart=/opt/digital-beamforming/.venv/bin/streamlit run main.py --server.headless=true --server.address=127.0.0.1 --server.port=8501
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp
CPUQuota=200%
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
