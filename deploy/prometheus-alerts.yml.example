groups:
  - name: digital-beamforming
    rules:
      - alert: DigitalBeamformingRedisUnavailable
        expr: min_over_time(dbf_compute_coordinator_available{backend="redis"}[2m]) == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: Redis compute coordination is unavailable

      - alert: DigitalBeamformingGlobalComputeSaturation
        expr: max(dbf_compute_global_active) / clamp_min(max(dbf_compute_global_limit), 1) >= 0.9
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: Global calculation slots are near saturation

      - alert: DigitalBeamformingComputeRejections
        expr: sum(rate(dbf_compute_requests_total{outcome=~"busy|rate_limited|deadline|error"}[5m])) > 0.1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: Calculation rejection or error rate is elevated

      - alert: DigitalBeamformingComputeP95Slow
        expr: histogram_quantile(0.95, sum by (le) (rate(dbf_compute_duration_seconds_bucket[10m]))) > 5
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: Calculation p95 latency exceeds five seconds
