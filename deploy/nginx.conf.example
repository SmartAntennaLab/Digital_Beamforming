# Replace domain and certificate paths before deployment. Create the password
# file outside the repository: htpasswd -c /etc/nginx/dbf.htpasswd <user>

events {}

http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    limit_req_zone $binary_remote_addr zone=dbf_per_ip:10m rate=30r/m;
    limit_conn_zone $binary_remote_addr zone=dbf_connections:10m;

    upstream digital_beamforming {
        server 127.0.0.1:8501;
        keepalive 16;
    }

    server {
        listen 80;
        server_name beamforming.example.com;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name beamforming.example.com;

        ssl_certificate /etc/letsencrypt/live/beamforming.example.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/beamforming.example.com/privkey.pem;

        auth_basic "Digital beamforming";
        auth_basic_user_file /etc/nginx/dbf.htpasswd;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        client_max_body_size 1m;
        limit_req_status 429;
        limit_conn_status 429;

        location = /_stcore/health {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            auth_basic off;
            proxy_pass http://digital_beamforming;
        }

        location / {
            limit_req zone=dbf_per_ip burst=10 nodelay;
            limit_conn dbf_connections 3;

            proxy_pass http://digital_beamforming;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
        }
    }
}
