[Unit]
Description=Digital beamforming Streamlit application replica
After=network-online.target redis.service oauth2-proxy.service
Wants=network-online.target

[Service]
Type=simple
User=digital-beamforming
Group=digital-beamforming
WorkingDirectory=/opt/digital-beamforming
EnvironmentFile=-/etc/digital-beamforming.env
Environment=DBF_COMPUTE_BACKEND=process
Environment=DBF_REQUIRE_PROXY_IDENTITY=true
ExecStart=/opt/digital-beamforming/.venv/bin/python server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp
CPUQuota=200%
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
